{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.eduardoabreu81/livewiki",
  "title": "livewiki",
  "description": "A repository wiki of Markdown pages anchored to real code: read, search, and verified writes.",
  "version": "0.3.2",
  "repository": {
    "url": "https://github.com/eduardoabreu81/livewiki",
    "source": "github"
  },
  "websiteUrl": "https://github.com/eduardoabreu81/livewiki",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@livewiki/mcp",
      "version": "0.3.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--repo",
          "description": "Path to the repository whose wiki should be served.",
          "format": "filepath",
          "isRequired": true,
          "placeholder": "/path/to/repo"
        }
      ]
    }
  ]
}
