{
  "name": "livewiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Living repository documentation anchored to code and verifiable against hallucination. See VISION.md and SPEC.md.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardoabreu81/livewiki.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm --filter @livewiki/core test:coverage",
    "lint:tsc": "pnpm -r lint:tsc"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@livewiki/cli": "workspace:*"
  },
  "packageManager": "pnpm@10.34.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.5",
      "@hono/node-server": "^2.0.12"
    }
  }
}