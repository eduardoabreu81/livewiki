flowchart LR
  Push["push to default branch / workflow_dispatch"]
  Checkout["actions/checkout@v6 (fetch-depth: 0)"]
  Setup["actions/setup-node@v6 (node 24)"]
  Index["livewiki index --quiet (deterministic, no LLM)"]
  StatusRun["livewiki status --json -> STATUS_JSON"]
  NodeScript["node -e: read JSON, build summary, decide exit code"]
  Summary["GITHUB_STEP_SUMMARY (debt table or green line)"]
  Fail["exit 1 when debt.total > 0 and mode != report"]
  Pass["exit 0 (zero tokens spent)"]

  Push --> Checkout --> Setup --> Index --> StatusRun --> NodeScript
  NodeScript --> Summary
  NodeScript -->|"debt.total > 0 & enforce"| Fail
  NodeScript -->|"debt.total == 0 or report"| Pass
