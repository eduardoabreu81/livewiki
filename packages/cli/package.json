{
  "name": "@livewiki/cli",
  "version": "0.3.4",
  "private": false,
  "type": "module",
  "description": "livewiki command-line interface — living documentation anchored to code, verifiable against hallucination.",
  "keywords": [
    "livewiki",
    "documentation",
    "code-documentation",
    "llm",
    "agents",
    "cli",
    "markdown",
    "wiki"
  ],
  "homepage": "https://github.com/eduardoabreu81/livewiki#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardoabreu81/livewiki.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "livewiki": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": ["dist", "skills", "templates", "!dist/**/*.test.*"],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livewiki/core": "workspace:*",
    "@livewiki/mcp": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
