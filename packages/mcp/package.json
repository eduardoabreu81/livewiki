{
  "name": "@livewiki/mcp",
  "version": "0.3.1",
  "mcpName": "io.github.eduardoabreu81/livewiki",
  "private": false,
  "type": "module",
  "description": "MCP server exposing a livewiki repository wiki to any MCP client.",
  "keywords": [
    "livewiki",
    "mcp",
    "model-context-protocol",
    "documentation",
    "code-documentation",
    "llm",
    "agents",
    "wiki"
  ],
  "homepage": "https://github.com/eduardoabreu81/livewiki#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardoabreu81/livewiki.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "bin": {
    "livewiki-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "default": "./dist/stdio.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livewiki/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
